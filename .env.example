APP_ENV=development
LOG_LEVEL=INFO
# Used by docker-compose.airgap.yml. Change this and the password inside DATABASE_URL together.
POSTGRES_PASSWORD=security_workflow
DATABASE_URL=postgresql+psycopg://security_workflow:security_workflow@localhost:5432/security_workflow
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=security-workflow
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=
# Optional override for the model served by local vLLM; avoids editing YAML for each local model.
VLLM_MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct
# Used only by docker-compose.airgap.yml. This must be the exact vLLM image loaded from the transfer kit.
VLLM_IMAGE=
# Absolute Linux path to the transferred Llama model directory, for example /opt/security-workflow/models/llama-3.2-1b-instruct.
VLLM_MODEL_DIR=
# Block Hugging Face libraries from attempting outbound access while loading optional NIST mapper models.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Guardrails for a small local model. Full tool evidence remains in PostgreSQL; only the model prompt is compacted.
VLLM_MAX_INPUT_CHARS=8000
VLLM_MAX_COMPLETION_TOKENS=768
# Used only by the separately run connected-zone NVD snapshot refresh; normal agent runs remain offline.
NVD_API_KEY=
SPLUNK_BASE_URL=https://splunk.example.internal:8089
SPLUNK_HEC_URL=https://splunk.example.internal:8088/services/collector
SPLUNK_TOKEN=
